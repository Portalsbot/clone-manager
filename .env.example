# Copy this file to .env and replace every placeholder with your own values.
BOT_TOKEN=123456789:REPLACE_WITH_BOTFATHER_TOKEN
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
OWNER_ID=123456789
ADMIN_IDS=
TOKEN_ENCRYPTION_KEY=GENERATE_WITH_python_scripts/generate_fernet_key.py

# Published Docker image references for the two clone products.
FILE_SHARING_IMAGE=ghcr.io/YOUR_GITHUB_OWNER/file-share-bot:latest
LINK_SHARING_IMAGE=ghcr.io/YOUR_GITHUB_OWNER/link-sharing-bot:latest

# Required only when the GHCR packages are private.
GHCR_USERNAME=
GHCR_TOKEN=

# Optional Docker runtime settings.
CLONE_DOCKER_NETWORK=
CLONE_SECRET_DIR=/var/lib/clone-manager/secrets
BRANDING_IMAGE_URL=https://raw.githubusercontent.com/Portalsbot/image/main/photo_2026-11-01_20-42-48.jpg
