# Copy this file to .env and replace every placeholder with your own values.
BOT_TOKEN=123456789:REPLACE_WITH_BOTFATHER_TOKEN
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
OWNER_ID=123456789
ADMIN_IDS=
TOKEN_ENCRYPTION_KEY=GENERATE_WITH_python_scripts/generate_fernet_key.py

# These exact private GHCR images are published by the two bot repositories' Actions workflows.
FILE_SHARING_IMAGE=ghcr.io/portalsbot/file-share-bot:latest
LINK_SHARING_IMAGE=ghcr.io/portalsbot/link-sharing-bot:latest

# Required to pull the private GHCR packages.
# GHCR_USERNAME is the GitHub account that owns the packages.
# GHCR_TOKEN must be a classic GitHub PAT with read:packages permission.
GHCR_USERNAME=
GHCR_TOKEN=

# Optional Docker runtime settings.
CLONE_DOCKER_NETWORK=
CLONE_SECRET_DIR=/var/lib/clone-manager/secrets

# Correct default branding image for all Clone Manager messages.
BRANDING_IMAGE_URL=https://i.ibb.co/PGpMYwYY/Gemini-Generated-Image-a7tjlia7tjlia7tj.png
