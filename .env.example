# Clone Manager Telegram and PostgreSQL settings
BOT_TOKEN=123456789:REPLACE_WITH_BOTFATHER_TOKEN
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
OWNER_ID=123456789
ADMIN_IDS=
TOKEN_ENCRYPTION_KEY=GENERATE_WITH_python_scripts/generate_fernet_key.py

# Render API credentials. Set the real values only in Render Environment.
RENDER_API_KEY=
RENDER_WORKSPACE_ID=
RENDER_REGISTRY_CREDENTIAL_ID=

# The existing private product repositories and their prebuilt GHCR images.
FILE_SHARING_REPO_URL=https://github.com/Portalsbot/File-Share-Bot
FILE_SHARING_IMAGE=ghcr.io/portalsbot/file-share-bot:latest
LINK_SHARING_REPO_URL=https://github.com/Portalsbot/link-sharing-bot
LINK_SHARING_IMAGE=ghcr.io/portalsbot/link-sharing-bot:latest

# Generated Background Worker defaults (the worker plan is billable).
RENDER_REGION=singapore
RENDER_WORKER_PLAN=starter

# Optional defaults inherited by each generated bot.
BRANDING_IMAGE_URL=https://i.ibb.co/PGpMYwYY/Gemini-Generated-Image-a7tjlia7tjlia7tj.png
CLONE_CHANNEL_URL=
CLONE_STORAGE_CHANNEL_ID=
CLONE_DEFAULT_AUTO_DELETE=0
CLONE_MAX_FILES_PER_USER=50

# Optional Link Sharing Bot shortener allowlist (comma-separated hostnames).
LINK_SHORTENER_ALLOWED_HOSTS=
